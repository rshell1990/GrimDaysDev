## Shared command names for dynamic song control.
class_name OvaniCommands
extends Object

## Shared identifier for mute, used so other scripts refer to the same setting or operation.
const MUTE: String = "mute"
## Shared identifier for intensity, used so other scripts refer to the same setting or operation.
const INTENSITY: String = "intensity"
## Shared identifier for volume, used so other scripts refer to the same setting or operation.
const VOLUME: String = "volume"
## Shared identifier for song, used so other scripts refer to the same setting or operation.
const SONG: String = "song"
## Shared identifier for silence, used so other scripts refer to the same setting or operation.
const SILENCE: String = "silence"
## Shared identifier for mode, used so other scripts refer to the same setting or operation.
const MODE: String = "mode"
