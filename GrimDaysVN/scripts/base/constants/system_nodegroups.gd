extends Object
## Shared group names used to find related nodes in a running scene.
class_name DDNodeTypes

## Shared identifier for persist, used so other scripts refer to the same setting or operation.
const PERSIST = "persist"
## Shared identifier for administrators, used so other scripts refer to the same setting or
## operation.
const ADMINISTRATORS = "VNAdministrators"
## Shared identifier for background, used so other scripts refer to the same setting or operation.
const BACKGROUND = "background"
## Shared identifier for main camera, used so other scripts refer to the same setting or operation.
const MAIN_CAMERA = "main_camera"
## Shared identifier for phantom camera, used so other scripts refer to the same setting or
## operation.
const PHANTOM_CAMERA = "phantom_camera"
## Shared identifier for sprite depth, used so other scripts refer to the same setting or operation.
const SPRITE_DEPTH = "sprite_depth"

## Shared identifier for node groups, used so other scripts refer to the same setting or operation.
const NODE_GROUPS = [PERSIST, ADMINISTRATORS, BACKGROUND, MAIN_CAMERA, PHANTOM_CAMERA, SPRITE_DEPTH]
