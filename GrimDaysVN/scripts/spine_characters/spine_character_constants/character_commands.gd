## Shared command names used to request character changes.
class_name CharacterCommands
extends Object

## Shared identifier for transfer, used so other scripts refer to the same setting or operation.
const TRANSFER: String = "transfer"
## Shared identifier for add, used so other scripts refer to the same setting or operation.
const ADD: String = "add"
## Shared identifier for expression, used so other scripts refer to the same setting or operation.
const EXPRESSION: String = "expression"
## Shared identifier for skin, used so other scripts refer to the same setting or operation.
const SKIN: String = "skin"
## Shared identifier for flip, used so other scripts refer to the same setting or operation.
const FLIP: String = "flip"
## Shared identifier for load checkpoint, used so other scripts refer to the same setting or
## operation.
const LOAD_CHECKPOINT: String = "load"
## Shared identifier for move, used so other scripts refer to the same setting or operation.
const MOVE: String = "move"
## Shared identifier for leave, used so other scripts refer to the same setting or operation.
const LEAVE: String = "leave"
