[gd_resource type="ShaderMaterial" format=3 uid="uid://bx2u3cdotfe4g"]

[sub_resource type="Shader" id="Shader_xpo0n"]
code = "shader_type spatial;
render_mode blend_mix;

uniform sampler2D sprite_texture;


void fragment() {
	vec4 sprite = texture(sprite_texture, UV);
	ALBEDO = sprite.rgb;
	ALPHA = sprite.a;
}
"

[sub_resource type="ViewportTexture" id="ViewportTexture_xpo0n"]
viewport_path = NodePath("Outer view")

[resource]
resource_local_to_scene = true
render_priority = 1
shader = SubResource("Shader_xpo0n")
