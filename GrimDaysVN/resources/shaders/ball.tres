code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_prepass_alpha;

uniform sampler2D tex_frg_3;
uniform float spin_speed : hint_range(10, 100);
uniform sampler2D tex_frg_2;



void fragment() {
// FloatConstant:7
	float n_out7p0 = 0.000000;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out7p0));


// Mix:4
	vec2 n_in4p0 = vec2(0.00000, 0.00000);
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = mix(n_in4p0, n_in4p1, vec2(n_out3p0.xy));


// Input:5
	float n_out5p0 = TIME;


// FloatFunc:6
	float n_out6p0 = sqrt(n_out5p0);


// FloatParameter:10
	float n_out10p0 = spin_speed;


// FloatOp:9
	float n_out9p0 = n_out6p0 * n_out10p0;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = vec2(n_out9p0) * n_in8p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out8p0);
	float n_out2p2 = n_out2p0.g;
	float n_out2p4 = n_out2p0.a;


// ColorConstant:11
	vec4 n_out11p0 = vec4(0.058000, 3.646000, 0.049000, 0.529000);


// Output:0
	ALBEDO = vec3(n_out4p0, 0.0);
	ALPHA = n_out2p2;
	EMISSION = vec3(n_out11p0.xyz);
	ALPHA_HASH_SCALE = n_out2p4;


}
