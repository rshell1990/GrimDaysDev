[sub_resource type="GDScript" id="GDScript_t4wwe"]
resource_name = "character_sprite_kneel"
script/source = "extends Node

signal moving()
signal stopped()
var character:CharacterOperator

func _ready():
	character = get_parent().get_parent()
	character.listen_for(moving, character.set_moving)
	character.listen_for(stopped, character.set_stopped)

func execute(data:Dictionary) -> void:
	moving.emit()
	var tween = create_tween()
	tween.set_ease(Tween.EASE_IN_OUT)
	await tween.tween_property(character, \"position:y\", data.target_x * -1.0, AnimationTimes.LONG).finished
	stopped.emit()
"

