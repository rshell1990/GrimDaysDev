[sub_resource type="GDScript" id="GDScript_yexsk"]
resource_name = "choice_watching"
script/source = "extends ScrollContainer

func _ready() -> void:
	var vbox = get_child(0)
	var button = vbox.get_child(0) as Button
	button.visibility_changed.connect(on_visibility_changed)

func on_visibility_changed() -> void:
	var vbox = get_child(0)
	var button = vbox.get_child(0) as Button
	if button.visible:
		modulate.a = 1.0
	else:
		modulate.a = 0.0
"

