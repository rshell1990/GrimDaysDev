extends Object
## Shared animation durations used to keep transitions consistent.
class_name AnimationTimes

## Fixed long value shared by all animation times instances.
const LONG = 1.0
## Fixed slow value shared by all animation times instances.
const SLOW = 0.66
## Fixed standard value shared by all animation times instances.
const STANDARD = 0.33
## Fixed fast value shared by all animation times instances.
const FAST = 0.15
## Fixed near instant value shared by all animation times instances.
const NEAR_INSTANT = 0.01
