[sub_resource type="GDScript" id="GDScript_civo7"]
resource_name = "splash_screen_control"
script/source = "extends Control
@export var video_player:VideoStreamPlayer
var skipping:bool = false
func _ready() -> void:
	video_player.finished.connect(on_video_finish)

func on_video_finish() -> void:
	if not skipping:
		await get_tree().create_timer(AnimationTimes.LONG).timeout
	fade_out()
	if not skipping:
		await get_tree().create_timer(AnimationTimes.STANDARD).timeout
	SceneManager.swap_scenes(self, get_tree().current_scene,\"res://GrimDays/scenes/main_menu.tscn\")

func _gui_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"accept\"):
		CustomLogger.confirm(self,_gui_input, \"Detected mouse click!\",CustomLogger.LEVEL.MILD)
		video_player.paused = true
		skipping = true
		fade_out()

func fade_out():
	var tween = create_tween()
	await tween.tween_property(video_player, \"modulate:a\", 0.0, AnimationTimes.FAST).finished
	on_video_finish()
"

