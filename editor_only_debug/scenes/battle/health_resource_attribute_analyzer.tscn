[sub_resource type="GDScript" id="GDScript_0xip5"]
resource_name = "curve_tester"
script/source = "extends Control
@export var health_curve:Curve
@export var energy_curve:Curve
@export var mana_curve:Curve
@export var physical_damage_curve:Curve
@export var magical_damage_curve:Curve


@export var health_label:Label

@export var energy_label:Label
@export var mana_label:Label
@export var physical_damage_label:Label
@export var magical_damage_label:Label

@export var vitality_spinbox:SpinBox

@export var strength_spinbox:SpinBox
@export var finesse_spinbox:SpinBox
@export var perception_spinbox:SpinBox
@export var endurance_spinbox:SpinBox
@export var willpower_spinbox:SpinBox
@export var mysticism_spinbox:SpinBox
@export var luck_spinbox:SpinBox

func _ready() -> void:
	vitality_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	strength_spinbox.value_changed.connect(on_strength_spinbox_changed)
	finesse_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	perception_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	endurance_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	willpower_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	mysticism_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	luck_spinbox.value_changed.connect(on_vitality_spinbox_changed)
	
	on_vitality_spinbox_changed(vitality_spinbox.value)
	on_strength_spinbox_changed(strength_spinbox.value)
	
func on_strength_spinbox_changed(new_value:float) -> void:
	var new_physical_damage:float = 0
	
	for x in range(1,new_value+1):
		new_physical_damage += physical_damage_curve.sample(x)
		
	new_physical_damage = roundi(new_physical_damage)
	physical_damage_label.text = str(int(new_physical_damage))
	
func on_finesse_spinbox_changed(new_value:float) -> void:
	pass
	
func on_perception_spinbox_changed(new_value:float) -> void:
	pass
	
func on_endurance_spinbox_changed(new_value:float) -> void:
	pass
	
func on_willpower_spinbox_changed(new_value:float) -> void:
	pass
	
func on_mysticism_spinbox_changed(new_value:float) -> void:
	pass

func on_luck_spinbox_changed(new_value:float) -> void:
	pass	
	
	
func on_vitality_spinbox_changed(new_value:float) -> void:
	var new_health:float = 0
	var new_energy:float = 0
	
	for x in range(1,new_value+1):
		new_health += health_curve.sample(x)
		new_energy += energy_curve.sample(x)
	new_health = roundi(new_health)
	new_energy = roundi(new_energy)
	health_label.text = str(new_health)
	energy_label.text = str(new_energy)
"

